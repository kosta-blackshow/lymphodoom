new file mode 100644
index 0000000..9ab080e
--- /dev/null
+++ b/src/lympho.h
@@ -0,0 +1,25 @@
+/* LYMPHODOOM: the organism's health ("BODY"), civilians and the game-over screen. */
+#ifndef __LYMPHO__
+#define __LYMPHO__
+
+#include "doomtype.h"
+#include "d_think.h"
+#include "p_mobj.h"
+
+#define LYMPHO_BODY_MAX 100000      /* 100% in thousandths of a percent */
+
+extern int lympho_body;             /* current body health */
+extern int lympho_dead_tics;        /* >0 while the "THE BODY DIED" screen is up */
+
+void lympho_new_game(int skill);
+void lympho_level_start(void);
+void lympho_reborn(void);
+void lympho_tick(void);             /* once per game tic in a level */
+void lympho_killed(mobj_t *target);
+dboolean lympho_is_civilian(const mobj_t *mo);
+int lympho_body_percent(void);
+void lympho_draw_hud(void);         /* BODY number and icon in the status bar */
+void lympho_draw_overlay(void);     /* game-over screen */
+void lympho_draw_score(int x, int y); /* "BODY NN%" (intermission, finale) */
+
+#endif
