diff --git a/src/lympho.c b/src/lympho.c
new file mode 100644
index 0000000..7b24168
--- /dev/null
+++ b/src/lympho.c
@@ -0,0 +1,171 @@
+/* LYMPHODOOM: the organism's health ("BODY").
+ *
+ * The infection drains the body over time; every enemy killed gives a little back,
+ * every own cell killed (by anyone) costs a lot. One value for the whole game.
+ * When it reaches zero the body dies and the game restarts from E1M1.
+ * Released under the GNU GPL v2 or later, like the rest of the engine.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include "doomstat.h"
+#include "d_event.h"
+#include "g_game.h"
+#include "info.h"
+#include "m_random.h"
+#include "s_sound.h"
+#include "sounds.h"
+#include "v_video.h"
+#include "w_wad.h"
+#include "r_patch.h"
+#include "m_argv.h"
+#include "lympho.h"
+
+int lympho_body = LYMPHO_BODY_MAX;
+int lympho_dead_tics;
+
+static int body_at_level_start = LYMPHO_BODY_MAX;
+static int reborn_pending;
+static int drain_per_tic = 3;       /* thousandths of a percent per tic */
+static int drain_frac;              /* remainder accumulator, in 1/1000 units */
+static int drain_num = 3175;        /* drain per tic * 1000 */
+
+#define GAMEOVER_TICS (TICRATE * 4)
+
+void lympho_new_game(int skill)
+{
+  /* full body: 15 minutes on COMMON COLD, 9 minutes on METASTASIS */
+  int seconds = skill >= sk_hard ? 9 * 60 : 15 * 60;
+  int p = M_CheckParm("-bodysecs");   /* testing only */
+  if (p && p < myargc - 1 && atoi(myargv[p + 1]) > 0)
+    seconds = atoi(myargv[p + 1]);
+  drain_num = (int)((long long)LYMPHO_BODY_MAX * 1000 / ((long long)seconds * TICRATE));
+  drain_frac = 0;
+  lympho_body = LYMPHO_BODY_MAX;
+  body_at_level_start = LYMPHO_BODY_MAX;
+  reborn_pending = 0;
+  lympho_dead_tics = 0;
+  (void)drain_per_tic;
+}
+
+void lympho_reborn(void)
+{
+  reborn_pending = 1;
+}
+
+void lympho_level_start(void)
+{
+  if (reborn_pending)
+    lympho_body = body_at_level_start;   /* T cell died: retry the level, no penalty */
+  else
+    body_at_level_start = lympho_body;
+  reborn_pending = 0;
+}
+
+static void clamp(void)
+{
+  if (lympho_body > LYMPHO_BODY_MAX) lympho_body = LYMPHO_BODY_MAX;
+  if (lympho_body < 0) lympho_body = 0;
+}
+
+void lympho_tick(void)
+{
+  if (lympho_dead_tics > 0)
+  {
+    if (--lympho_dead_tics == 0)
+      G_DeferedInitNew(gameskill, 1, 1);
+    return;
+  }
+  if (gamestate != GS_LEVEL || demoplayback)
+    return;
+  drain_frac += drain_num;
+  lympho_body -= drain_frac / 1000;
+  drain_frac %= 1000;
+  clamp();
+  if (lympho_body == 0)
+  {
+    lympho_dead_tics = GAMEOVER_TICS;
+    S_StartSound(NULL, sfx_pldeth);
+  }
+}
+
+dboolean lympho_is_civilian(const mobj_t *mo)
+{
+  int n = mo->info->doomednum;
+  return n == 2028 || n == 35 || n == 85 || n == 86;
+}
+
+void lympho_killed(mobj_t *target)
+{
+  if (lympho_dead_tics)
+    return;
+  if (lympho_is_civilian(target))
+    lympho_body -= 5000;               /* autoimmune damage */
+  else if (target->flags & MF_COUNTKILL)
+    lympho_body += target->type == MT_BRUISER ? 10000 : 1000;
+  clamp();
+}
+
+int lympho_body_percent(void)
+{
+  return (lympho_body + 999) / 1000;
+}
+
+/* ------------------------------------------------------------------ drawing */
+
+static void draw_num(int x_right, int y, int value, const char *digits, const char *pct, int flags)
+{
+  char name[9];
+  int x = x_right;
+  int lump = W_CheckNumForName(pct);
+  if (lump >= 0)
+  {
+    x -= R_NumPatchWidth(lump);
+    V_DrawNumPatch(x, y, 0, lump, CR_DEFAULT, flags);
+  }
+  do
+  {
+    sprintf(name, "%s%d", digits, value % 10);
+    lump = W_CheckNumForName(name);
+    if (lump < 0) return;
+    x -= R_NumPatchWidth(lump);
+    V_DrawNumPatch(x, y, 0, lump, CR_DEFAULT, flags);
+    value /= 10;
+  } while (value);
+}
+
+void lympho_draw_hud(void)
+{
+  int p = lympho_body_percent();
+  int low = p < 25;
+  int blink = low && ((gametic / 8) & 1);
+  char icon[9];
+  int lump;
+
+  sprintf(icon, "STBICON%d", p >= 75 ? 0 : p >= 50 ? 1 : p >= 25 ? 2 : 3);
+  lump = W_CheckNumForName(icon);
+  if (lump >= 0)
+    V_DrawNumPatch(107, 171, 0, lump, CR_DEFAULT, VPT_ALIGN_BOTTOM);
+  draw_num(141, 172, p, blink ? "STBRNM" : "STBNUM", blink ? "STBRPC" : "STBPCT", VPT_ALIGN_BOTTOM);
+}
+
+void lympho_draw_score(int x, int y)
+{
+  int lump = W_CheckNumForName("WIBODY");
+  if (lump >= 0)
+    V_DrawNumPatch(x, y, 0, lump, CR_DEFAULT, VPT_STRETCH);
+  draw_num(320 - x, y, lympho_body_percent(), "WINUM", "WIPCNT", VPT_STRETCH);
+}
+
+void lympho_draw_overlay(void)
+{
+  int lump;
+  if (!lympho_dead_tics)
+    return;
+  lump = W_CheckNumForName("BODYDEAD");
+  if (lump >= 0)
+  {
+    V_FillBorder(-1, 0);
+    V_DrawNumPatch(0, 0, 0, lump, CR_DEFAULT, VPT_STRETCH);
+  }
+}
