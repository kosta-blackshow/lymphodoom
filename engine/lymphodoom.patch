diff --git a/src/p_enemy.c b/src/p_enemy.c
index 49fcd23..845da0c 100644
--- a/src/p_enemy.c
+++ b/src/p_enemy.c
@@ -1069,6 +1069,61 @@ void A_KeenDie(mobj_t* mo)
 // ACTION ROUTINES
 //
 
+// LYMPHODOOM: own body cells (civilians) wander around and run from nearby
+// infection. They never attack; the threat is kept in actor->target.
+void A_CivWander(mobj_t *actor)
+{
+  mobj_t *threat;
+
+  if (--actor->threshold <= 0)
+  {
+    thinker_t *th;
+    fixed_t best = 384*FRACUNIT;
+    mobj_t *found = NULL;
+
+    actor->threshold = 6;
+    for (th = thinkercap.next; th != &thinkercap; th = th->next)
+    {
+      mobj_t *mo;
+      fixed_t d;
+
+      if (th->function != P_MobjThinker)
+        continue;
+      mo = (mobj_t *) th;
+      if (!(mo->flags & MF_COUNTKILL) || mo->health <= 0)
+        continue;
+      d = P_AproxDistance(mo->x - actor->x, mo->y - actor->y);
+      if (d < best && P_CheckSight(actor, mo))
+      {
+        best = d;
+        found = mo;
+      }
+    }
+    P_SetTarget(&actor->target, found);
+  }
+
+  threat = actor->target;
+  if (threat && threat->health > 0)
+  {
+    angle_t away = R_PointToAngle2(threat->x, threat->y, actor->x, actor->y);
+    actor->movedir = ((away + ANG45/2) >> 29) & 7;
+    if (!P_Move(actor, false))
+    {
+      actor->movedir = (actor->movedir + ((P_Random(pr_trywalk) & 1) ? 1 : 7)) & 7;
+      P_Move(actor, false);
+    }
+    else
+      P_Move(actor, false);   // running: twice the walking speed
+  }
+  else if (--actor->movecount < 0 || actor->movedir == DI_NODIR || !P_Move(actor, false))
+  {
+    actor->movedir = P_Random(pr_trywalk) & 7;
+    actor->movecount = 4 + (P_Random(pr_trywalk) & 15);
+  }
+  if (actor->movedir < 8)
+    actor->angle = (angle_t)actor->movedir << 29;
+}
+
